# MercadoBot Personal - configuración local
APP_NAME=MercadoBot Personal
HOST=127.0.0.1
PORT=8000
SCAN_SECONDS=300
INTERVAL=1h
PERIOD=730d
MIN_ROWS=350
ALERT_THRESHOLD=0.68
MAX_WORKERS=4
MODEL_MAX_AGE_HOURS=6
DATABASE_PATH=data/mercadobot.db
MODEL_DIR=models
LOG_LEVEL=INFO

# Fuentes premium/tiempo real opcionales. Nunca las publiques en GitHub.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Avisos opcionales
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
