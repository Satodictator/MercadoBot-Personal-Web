# MercadoBot Personal OS - configuración local
APP_NAME=MercadoBot Personal OS
HOST=127.0.0.1
PORT=8000
SCAN_SECONDS=300
INTERVAL=1h
PERIOD=730d
MIN_ROWS=350
ALERT_THRESHOLD=0.68
MAX_WORKERS=4
MODEL_MAX_AGE_HOURS=6
DATABASE_PATH=data/mercadobot.db
MODEL_DIR=models
LOG_LEVEL=INFO
USER_TIMEZONE=America/Detroit

# Precios de tokens y elección automática de pares
CRYPTO_MARKET_URLS=https://data-api.binance.vision,https://api.binance.com,https://api.binance.us
CRYPTO_REQUEST_TIMEOUT=20
CRYPTO_QUOTE_ASSETS=USDT,USDC,BTC,ETH
CRYPTO_TOP_PAIRS=120
CRYPTO_TOP_TOKENS=100
CRYPTO_PAIR_MIN_VOLUME=250000
CRYPTO_PAIR_MAX_SPREAD_BPS=60

# Arbitraje triangular conservador: detección únicamente
ARBITRAGE_START_ASSETS=USDT,USDC
ARBITRAGE_FEE_BPS=10
ARBITRAGE_SLIPPAGE_BPS=8
ARBITRAGE_MIN_NET_BPS=12
ARBITRAGE_MIN_VOLUME=1000000
ARBITRAGE_MAX_SPREAD_BPS=25
ARBITRAGE_MIN_CAPACITY_USD=100
ARBITRAGE_TOP_RESULTS=25

# Vault personal cifrado. Nunca publiques la clave.
PERSONAL_VAULT_PATH=vault/personal.enc
STATE_ENCRYPTION_KEY=
PUBLISH_PRIVATE_SUMMARY=false
EXECUTION_MODE=DISABLED

# Fuentes premium/tiempo real opcionales
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Avisos opcionales
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
